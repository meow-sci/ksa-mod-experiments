{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meowsci.io/ksa-mods/steely-eyed-missile-kitten/mission-schema.json",
  "title": "KSA Mission Definition",
  "description": "Mission definition file for the Steely-Eyed Missile Kitten mod",
  "type": "object",
  "required": ["name", "objective"],
  "properties": {
    "name": { "type": "string", "description": "Display name of the mission" },
    "description": { "type": "string", "description": "Longer description of the mission" },
    "category": { 
      "type": "string", 
      "enum": ["orbital", "landing", "exploration", "speed", "distance"],
      "description": "Mission category for grouping"
    },
    "difficulty": { 
      "type": "integer", 
      "minimum": 1, 
      "maximum": 5,
      "description": "Difficulty rating 1-5"
    },
    "objective": { "$ref": "#/$defs/condition" }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "altitude_above", "altitude_below",
            "speed_above", "speed_below",
            "apoapsis_above",
            "periapsis_above", "periapsis_below",
            "eccentricity_below",
            "inclination_between",
            "event_occurred",
            "in_soi_of", "on_surface_of",
            "all_of", "any_of", "sequence"
          ]
        },
        "value": { "type": "number", "description": "Threshold value (meters, m/s, etc.)" },
        "min_value": { "type": "number" },
        "max_value": { "type": "number" },
        "speed_frame": { 
          "type": "string", 
          "enum": ["orbital", "surface", "inertial"]
        },
        "event_type": {
          "type": "string",
          "enum": [
            "soi_changed", "liftoff", "landed", "splash_down",
            "atmosphere_entered", "atmosphere_exited",
            "stable_orbit_achieved", "orbit_escaped"
          ]
        },
        "body_id": { "type": "string", "description": "Celestial body ID (e.g. 'Kerbin', 'Mun')" },
        "sub_conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition" }
        },
        "description": { "type": "string", "description": "Human-readable condition description" }
      }
    }
  }
}
