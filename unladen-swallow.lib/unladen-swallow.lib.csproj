<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>MeowSci.UnladenSwallowLib</AssemblyName>
    <RootNamespace>MeowSci.UnladenSwallowLib</RootNamespace>
    <Description>HTTP RPC server library for the unladen-swallow KSA mod</Description>
    <PackageId>MeowSci.UnladenSwallowLib</PackageId>
    <PrunePackageReference>false</PrunePackageReference>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ksa-abstractions.lib\ksa-abstractions.lib.csproj" />
    <ProjectReference Include="..\glass.lib\glass.lib.csproj" />
    <ProjectReference Include="..\blinky.lib\blinky.lib.csproj" />
    <ProjectReference Include="..\its-so-shiny.lib\its-so-shiny.lib.csproj" />
    <ProjectReference Include="..\camera-controller-override.lib\camera-controller-override.lib.csproj" />
    <ProjectReference Include="..\garrys-torch.lib\garrys-torch.lib.csproj" />
    <ProjectReference Include="..\zippo.lib\zippo.lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GenHTTP.Core" Version="10.5.0" />
    <PackageReference Include="GenHTTP.Modules.Conversion" Version="10.5.0" />
    <PackageReference Include="GenHTTP.Modules.Functional" Version="10.5.0" />
    <PackageReference Include="GenHTTP.Modules.Layouting" Version="10.5.0" />
    <PackageReference Include="GenHTTP.Modules.Practices" Version="10.5.0" />
    <PackageReference Include="GenHTTP.Modules.Security" Version="10.5.0" />
    <PackageReference Include="GenHTTP.Modules.ErrorHandling" Version="10.5.0" />
    <PackageReference Include="GenHTTP.Modules.IO" Version="10.5.0" />

    <!--
      GenHTTP drags in Microsoft.Extensions.ObjectPool 10.x transitively. The game ships (and has
      already loaded) 11.x, which is what Brutal.Core.Strings/Brutal.Core.Logging reference, so
      excluding every asset here lets the game's DLL below be the single provider. Without this the
      package version stays "primary" and MSBuild reports an unresolvable MSB3277 10-vs-11 conflict.
    -->
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.3" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Brutal.Core.Common" Condition="Exists('$(KSAFolder)Brutal.Core.Common.dll')">
      <HintPath>$(KSAFolder)Brutal.Core.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Numerics" Condition="Exists('$(KSAFolder)Brutal.Core.Numerics.dll')">
      <HintPath>$(KSAFolder)Brutal.Core.Numerics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.ImGui" Condition="Exists('$(KSAFolder)Brutal.ImGui.dll')">
      <HintPath>$(KSAFolder)Brutal.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.ImGui.Abstractions" Condition="Exists('$(KSAFolder)Brutal.ImGui.Abstractions.dll')">
      <HintPath>$(KSAFolder)Brutal.ImGui.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Strings" Condition="Exists('$(KSAFolder)Brutal.Core.Strings.dll')">
      <HintPath>$(KSAFolder)Brutal.Core.Strings.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="KSA" Condition="Exists('$(KSAFolder)KSA.dll')">
      <HintPath>$(KSAFolder)KSA.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!--
      Microsoft.Extensions.ObjectPool is a game-shipped assembly, so bind to the game's copy.

      GenHTTP pulls this in transitively at 10.x, but the game ships (and has already loaded)
      11.x, which is also what Brutal.Core.Strings/Brutal.Core.Logging reference. Compiling
      against the package version produced an MSB3277 10.0.0.0-vs-11.0.0.0 conflict and shipped a
      stale 10.x copy into the mod folder that could never win at runtime. Referencing the game's
      DLL with Private=false makes compile-time match runtime and drops the redundant copy.
    -->
    <Reference Include="Microsoft.Extensions.ObjectPool" Condition="Exists('$(KSAFolder)Microsoft.Extensions.ObjectPool.dll')">
      <HintPath>$(KSAFolder)Microsoft.Extensions.ObjectPool.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
