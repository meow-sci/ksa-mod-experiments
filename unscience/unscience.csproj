<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- <TargetFramework>net10.0</TargetFramework> -->
    <AssemblyName>MeowSci.Unscience</AssemblyName>
    <!-- <LangVersion>13</LangVersion> -->
    <!-- <Nullable>enable</Nullable> -->
    <!-- <ImplicitUsings>disable</ImplicitUsings> -->
    <!-- <GenerateDocumentationFile>false</GenerateDocumentationFile> -->
    <!-- <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies> -->
    <DistDir>$(SelectedDistModDir)unscience\</DistDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\average-twr.lib\average-twr.lib.csproj" />
    <ProjectReference Include="..\blinky.lib\blinky.lib.csproj" />
    <ProjectReference Include="..\byo-music.lib\byo-music.lib.csproj" />
    <ProjectReference Include="..\camera-controller-override.lib\camera-controller-override.lib.csproj" />
    <ProjectReference Include="..\con-man.lib\con-man.lib.csproj" />
    <ProjectReference Include="..\doh.lib\doh.lib.csproj" />
    <ProjectReference Include="..\eternal-flame.lib\eternal-flame.lib.csproj" />
    <ProjectReference Include="..\garrys-torch.lib\garrys-torch.lib.csproj" />
    <ProjectReference Include="..\geeforce.lib\geeforce.lib.csproj" />
    <ProjectReference Include="..\glass.lib\glass.lib.csproj" />
    <ProjectReference Include="..\i-feel-seen.lib\i-feel-seen.lib.csproj" />
    <ProjectReference Include="..\its-so-shiny.lib\its-so-shiny.lib.csproj" />
    <ProjectReference Include="..\kitten-animations.lib\kitten-animations.lib.csproj" />
    <ProjectReference Include="..\kiwis-marbles.lib\kiwis-marbles.lib.csproj" />
    <ProjectReference Include="..\ksa-abstractions.lib\ksa-abstractions.lib.csproj" />
    <ProjectReference Include="..\skittles.lib\skittles.lib.csproj" />
    <ProjectReference Include="..\unladen-swallow.lib\unladen-swallow.lib.csproj" />
    <ProjectReference Include="..\zippo.lib\zippo.lib.csproj" />
    <ProjectReference Include="..\humble-arteest.lib\humble-arteest.lib.csproj" />
    <ProjectReference Include="..\flexo.lib\flexo.lib.csproj" />
    <ProjectReference Include="..\kitchen-sink.lib\kitchen-sink.lib.csproj" />
    <ProjectReference Include="..\red-alert.lib\red-alert.lib.csproj" />
    <ProjectReference Include="..\thug-life.lib\thug-life.lib.csproj" />
    <ProjectReference Include="..\parts-now.lib\parts-now.lib.csproj" />
    <ProjectReference Include="..\dont-stifle-me.lib\dont-stifle-me.lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StarMap.API" Version="0.3.6" PrivateAssets="all" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />

    <!--
      See unladen-swallow.lib: GenHTTP (reached transitively through unladen-swallow.lib) pulls
      Microsoft.Extensions.ObjectPool 10.x, but the game ships and loads 11.x, which is what
      Brutal.Core.Strings/Brutal.Core.Logging reference. Excluding the package's assets lets the
      game's DLL below be the single provider, clearing the MSB3277 10-vs-11 conflict.
    -->
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.3" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Brutal.Core.Common" Condition="Exists('$(KSAFolder)Brutal.Core.Common.dll')">
      <HintPath>$(KSAFolder)Brutal.Core.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Numerics" Condition="Exists('$(KSAFolder)Brutal.Core.Numerics.dll')">
      <HintPath>$(KSAFolder)Brutal.Core.Numerics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.ImGui" Condition="Exists('$(KSAFolder)Brutal.ImGui.dll')">
      <HintPath>$(KSAFolder)Brutal.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.ImGui.Abstractions" Condition="Exists('$(KSAFolder)Brutal.ImGui.Abstractions.dll')">
      <HintPath>$(KSAFolder)Brutal.ImGui.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Strings" Condition="Exists('$(KSAFolder)Brutal.Core.Strings.dll')">
      <HintPath>$(KSAFolder)Brutal.Core.Strings.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="KSA" Condition="Exists('$(KSAFolder)KSA.dll')">
      <HintPath>$(KSAFolder)KSA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Vulkan" Condition="Exists('$(KSAFolder)Brutal.Vulkan.dll')">
      <HintPath>$(KSAFolder)Brutal.Vulkan.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game-shipped assembly: bind to the game's 11.x copy, don't ship our own (see above). -->
    <Reference Include="Microsoft.Extensions.ObjectPool" Condition="Exists('$(KSAFolder)Microsoft.Extensions.ObjectPool.dll')">
      <HintPath>$(KSAFolder)Microsoft.Extensions.ObjectPool.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="mod.toml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyCustomContent" AfterTargets="AfterBuild">
    <MakeDir Directories="$(DistDir)" />
    <ItemGroup>
      <FilesToCopy Include="$(OutputPath)mod.toml" />
      <FilesToCopy Include="$(OutputPath)$(AssemblyName).dll" />
      <FilesToCopy Include="$(OutputPath)$(AssemblyName).pdb" />
      <FilesToCopy Include="$(OutputPath)$(AssemblyName).deps.json" />
      <FilesToCopy Include="$(MSBuildThisFileDirectory)..\LICENSE" />
    </ItemGroup>
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(DistDir)" />
    <ItemGroup>
      <MeowSciAssemblies Include="$(TargetDir)MeowSci.*.dll;$(TargetDir)MeowSci.*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(MeowSciAssemblies)" DestinationFolder="$(DistDir)" Condition="'@(MeowSciAssemblies)' != ''" />
    <Copy SourceFiles="$(TargetDir)Tomlyn.dll" DestinationFolder="$(DistDir)" Condition="Exists('$(TargetDir)Tomlyn.dll')" />

    <!-- Dynamically discover GenHTTP.*.dll files -->
    <ItemGroup>
      <GenHttpAssemblies Include="$(TargetDir)GenHTTP.*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(GenHttpAssemblies)"
          DestinationFolder="$(DistDir)"
          Condition="'@(GenHttpAssemblies)' != ''" />

    <!-- Transitive dependencies required by GenHTTP at runtime.
         Microsoft.Extensions.ObjectPool is deliberately NOT listed: the game ships and loads its
         own 11.x copy, so shipping ours would be a stale duplicate that never wins. -->
    <ItemGroup>
      <GenHttpTransitiveDeps Include="$(TargetDir)Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
      <GenHttpTransitiveDeps Include="$(TargetDir)Microsoft.Extensions.Logging.Abstractions.dll" />
      <!-- <GenHttpTransitiveDeps Include="$(TargetDir)Microsoft.Data.Sqlite.dll" /> -->
      <!-- <GenHttpTransitiveDeps Include="$(TargetDir)SQLitePCLRaw.batteries_v2.dll" /> -->
      <!-- <GenHttpTransitiveDeps Include="$(TargetDir)SQLitePCLRaw.core.dll" /> -->
      <!-- <GenHttpTransitiveDeps Include="$(TargetDir)SQLitePCLRaw.provider.e_sqlite3.dll" /> -->
      <GenHttpTransitiveDeps Include="$(TargetDir)Cottle.dll" />
      <GenHttpTransitiveDeps Include="$(TargetDir)YamlDotNet.dll" />
      <GenHttpTransitiveDeps Include="$(TargetDir)Microsoft.CodeAnalysis.dll" />
      <GenHttpTransitiveDeps Include="$(TargetDir)Microsoft.CodeAnalysis.CSharp.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(GenHttpTransitiveDeps)"
          DestinationFolder="$(DistDir)"
          Condition="'@(GenHttpTransitiveDeps)' != ''" />

    <!-- Copy third-party licenses -->
    <MakeDir Directories="$(DistDir)third-party-licenses" />
    <ItemGroup>
      <ThirdPartyLicenses Include="$(MSBuildThisFileDirectory)..\third-party-licenses\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ThirdPartyLicenses)" DestinationFolder="$(DistDir)third-party-licenses" Condition="'@(ThirdPartyLicenses)' != ''" />

    <Message Text="Copied mod files to $(DistDir)" Importance="high" />
  </Target>

</Project>
